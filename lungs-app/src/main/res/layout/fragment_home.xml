<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"> <!-- Soft, premium cool-gray background -->

    <!-- Premium Icon Treatment -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/iconContainer"
        android:layout_width="104dp"
        android:layout_height="104dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.45"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/appTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lungs"
            app:tint="#1E3A8A" /> <!-- Deep Trust Blue -->
    </com.google.android.material.card.MaterialCardView>

    <!-- Typography -->
    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/home_title"
        android:textColor="#0F172A"
        android:textSize="32sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.03"
        app:layout_constraintTop_toBottomOf="@id/iconContainer"
        app:layout_constraintBottom_toTopOf="@id/appSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/appSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="12dp"
        android:text="@string/home_subtitle"
        android:textColor="#64748B"
        android:textSize="16sp"
        android:textAlignment="center"
        android:lineSpacingExtra="6dp"
        app:layout_constraintTop_toBottomOf="@id/appTitle"
        app:layout_constraintBottom_toTopOf="@id/btnAddPatient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Centered Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddPatient"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="48dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:text="@string/add_new_patient"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        app:backgroundTint="#1E3A8A"
        app:cornerRadius="16dp"
        app:elevation="2dp"
        app:icon="@android:drawable/ic_input_add"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/appSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnViewSaved"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewSaved"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:text="@string/view_saved_patients"
        android:textAllCaps="false"
        android:textColor="#1E3A8A"
        android:textSize="17sp"
        app:cornerRadius="16dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1.5dp"
        app:iconTint="#1E3A8A"
        app:layout_constraintTop_toBottomOf="@id/btnAddPatient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>