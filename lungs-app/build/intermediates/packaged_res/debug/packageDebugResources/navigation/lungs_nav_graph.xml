<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lungs_nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Home: two entry points -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.musediagnostics.taal.lungs.ui.home.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_patient_form"
            app:destination="@id/patientFormFragment" />
        <action
            android:id="@+id/action_home_to_saved_patients"
            app:destination="@id/savedPatientsFragment" />
    </fragment>

    <!-- Patient details form (new: patientId=-1, edit: patientId=existing id) -->
    <fragment
        android:id="@+id/patientFormFragment"
        android:name="com.musediagnostics.taal.lungs.ui.patient.PatientFormFragment"
        android:label="Patient Details">
        <argument
            android:name="patientId"
            app:argType="long"
            android:defaultValue="-1L" />
        <action
            android:id="@+id/action_patient_form_to_placement"
            app:destination="@id/placementFragment" />
    </fragment>

    <!-- 4-region lung placement map -->
    <fragment
        android:id="@+id/placementFragment"
        android:name="com.musediagnostics.taal.lungs.ui.placement.PlacementFragment"
        android:label="Placement">
        <argument android:name="patientId" app:argType="long" />
        <argument android:name="patientSeqNum" app:argType="integer" />
        <argument android:name="sessionId" app:argType="long" />
        <argument android:name="sessionNumber" app:argType="integer" />
        <action
            android:id="@+id/action_placement_to_recording"
            app:destination="@id/lungsRecordingFragment" />
    </fragment>

    <!-- Recording screen (always LUNGS filter) -->
    <fragment
        android:id="@+id/lungsRecordingFragment"
        android:name="com.musediagnostics.taal.lungs.ui.recording.LungsRecordingFragment"
        android:label="Recording">
        <argument android:name="patientId" app:argType="long" />
        <argument android:name="patientSeqNum" app:argType="integer" />
        <argument android:name="sessionId" app:argType="long" />
        <argument android:name="sessionNumber" app:argType="integer" />
        <argument android:name="pointCode" app:argType="string" />
        <action
            android:id="@+id/action_lungs_recording_to_player"
            app:destination="@id/lungsPlayerFragment" />
    </fragment>

    <!-- Player screen with waveform review and auto-save -->
    <fragment
        android:id="@+id/lungsPlayerFragment"
        android:name="com.musediagnostics.taal.lungs.ui.player.LungsPlayerFragment"
        android:label="Review">
        <argument android:name="filePath" app:argType="string" android:defaultValue="" />
        <argument android:name="rawFilePath" app:argType="string" android:defaultValue="" />
        <argument android:name="patientId" app:argType="long" />
        <argument android:name="patientSeqNum" app:argType="integer" />
        <argument android:name="sessionId" app:argType="long" />
        <argument android:name="sessionNumber" app:argType="integer" />
        <argument android:name="pointCode" app:argType="string" android:defaultValue="" />
        <argument android:name="isReviewMode" app:argType="boolean" android:defaultValue="false" />
    </fragment>

    <!-- Saved patients list -->
    <fragment
        android:id="@+id/savedPatientsFragment"
        android:name="com.musediagnostics.taal.lungs.ui.home.SavedPatientsFragment"
        android:label="Saved Recordings">
        <action
            android:id="@+id/action_saved_to_sessions_list"
            app:destination="@id/patientSessionsListFragment" />
    </fragment>

    <!-- Sessions list for a patient (patient profile + all sessions + Record Again) -->
    <fragment
        android:id="@+id/patientSessionsListFragment"
        android:name="com.musediagnostics.taal.lungs.ui.session.PatientSessionsListFragment"
        android:label="Patient Sessions">
        <argument android:name="patientId" app:argType="long" />
        <argument android:name="patientSeqNum" app:argType="integer" />
        <action
            android:id="@+id/action_sessions_list_to_session"
            app:destination="@id/patientSessionFragment" />
        <action
            android:id="@+id/action_sessions_list_to_placement"
            app:destination="@id/placementFragment" />
        <action
            android:id="@+id/action_sessions_list_to_edit_patient"
            app:destination="@id/patientFormFragment" />
    </fragment>

    <!-- Single session review screen -->
    <fragment
        android:id="@+id/patientSessionFragment"
        android:name="com.musediagnostics.taal.lungs.ui.session.PatientSessionFragment"
        android:label="Session Report">
        <argument android:name="patientId" app:argType="long" />
        <argument android:name="patientSeqNum" app:argType="integer" />
        <argument android:name="sessionId" app:argType="long" />
        <argument android:name="sessionNumber" app:argType="integer" />
        <action
            android:id="@+id/action_session_to_placement"
            app:destination="@id/placementFragment" />
        <action
            android:id="@+id/action_session_to_player"
            app:destination="@id/lungsPlayerFragment" />
        <action
            android:id="@+id/action_session_to_edit_patient"
            app:destination="@id/patientFormFragment" />
        <action
            android:id="@+id/action_session_to_denoiser"
            app:destination="@id/denoiserFragment" />
    </fragment>

    <!-- Denoiser screen -->
    <fragment
        android:id="@+id/denoiserFragment"
        android:name="com.musediagnostics.taal.lungs.ui.denoiser.DenoiserFragment"
        android:label="Denoised Recordings">
        <argument android:name="patientId" app:argType="long" />
        <argument android:name="patientSeqNum" app:argType="integer" />
        <action
            android:id="@+id/action_denoiser_to_player"
            app:destination="@id/lungsPlayerFragment" />
    </fragment>

</navigation>
