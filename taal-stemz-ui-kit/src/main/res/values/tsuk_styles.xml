<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="tsuk_TaalText" parent="android:Widget.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tsuk_text_primary</item>
    </style>
    <style name="tsuk_TaalText.Timer">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tsuk_teal_primary</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="tsuk_Theme.Taal" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/tsuk_teal_primary</item>
        <item name="colorPrimaryDark">@color/tsuk_teal_dark</item>
        <item name="colorAccent">@color/tsuk_blue_primary</item>
        <item name="colorOnPrimary">@color/tsuk_white</item>
        <item name="android:windowBackground">@color/tsuk_white</item>
        <item name="android:statusBarColor">@color/tsuk_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/tsuk_text_primary</item>
        <item name="android:textColorSecondary">@color/tsuk_text_secondary</item>
        <item name="android:textColorHint">@color/tsuk_text_hint</item>
    </style>
</resources>
